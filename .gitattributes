# Normalise line endings. The repo is edited on Windows and built on Linux in
# CI, so without this every file shows as modified purely from CRLF churn and
# git status stops being useful for spotting real changes.
* text=auto eol=lf

# Binary assets - never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary